# ==============================================================
# CONTACT FORM CONFIGURATION (.env)
# ==============================================================
# Copy this file to '.env' in your project root to activate live email delivery:
#   cp .env.example .env
#
# OPTION 1: FORMSPREE (Recommended - takes 60 seconds, no code changes needed)
# 1. Sign up for free at https://formspree.io
# 2. Click "+ New Form", give it a name like "Portfolio Contact", and set your recipient email (djaiseal0807@gmail.com).
# 3. Formspree will give you an endpoint URL like: https://formspree.io/f/mqkenvba
# 4. Paste that endpoint URL below:
REACT_APP_FORMSPREE_ENDPOINT=https://formspree.io/f/your_form_id_here

# OPTION 2: EMAILJS (Alternative)
# If using EmailJS instead of Formspree:
# 1. Sign up at https://www.emailjs.com
# 2. Add an email service (e.g. Gmail) and create an email template.
# 3. Paste your credentials below:
# REACT_APP_EMAILJS_SERVICE_ID=your_service_id
# REACT_APP_EMAILJS_TEMPLATE_ID=your_template_id
# REACT_APP_EMAILJS_PUBLIC_KEY=your_public_key
